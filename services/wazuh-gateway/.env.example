PORT=8787
WAZUH_CONNECTION_KEY=piersec-dev
# Replace the documentation IPs below with the private Wazuh host IP.
WAZUH_MANAGER_URL=https://192.0.2.10:55000
WAZUH_MANAGER_USERNAME_FILE=/run/secrets/wazuh_manager_username
WAZUH_MANAGER_PASSWORD_FILE=/run/secrets/wazuh_manager_password
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_INDEXER_HOST_IP=192.0.2.10
WAZUH_INDEXER_USERNAME_FILE=/run/secrets/wazuh_indexer_username
WAZUH_INDEXER_PASSWORD_FILE=/run/secrets/wazuh_indexer_password
WAZUH_GATEWAY_SERVICE_TOKEN_FILE=/run/secrets/wazuh_gateway_service_token
# Mount the CA used by the Manager API here. Leave unset only if its certificate chains to a trusted CA.
WAZUH_MANAGER_CA_FILE=/run/secrets/wazuh_manager_ca.crt
# Mount the CA used by the Indexer here. Do not disable TLS certificate validation.
WAZUH_INDEXER_CA_FILE=/run/secrets/wazuh_indexer_ca.crt

